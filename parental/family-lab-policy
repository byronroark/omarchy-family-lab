ETC = Path('/etc/family-lab')
DATA = Path('/var/lib/family-lab')
RUNTIME = Path('/run/family-lab')
SOCKET = RUNTIME / 'policy.sock'
LEARNER_SOCKET = RUNTIME / 'learner.sock'
MAX_BYTES = 131072
DAYS = ('mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun')

def guard_ready(etc=ETC):
    path=etc/'guard-ready'
    if not path.exists():return False
    try:
        marker=read(path)
        paths=('/usr/local/libexec/family-lab-policy','/usr/local/libexec/family_breaks.py','/usr/local/libexec/family_guard.py','/usr/local/share/family-lab/guard/shell.qml','/usr/local/share/family-lab/guard/Dino/BreakCard.qml')
        return set(marker)=={'boot','accepted','hashes'} and marker['hashes']=={name:hashlib.sha256(Path(name).read_bytes()).hexdigest() for name in paths}
    except (OSError,ValueError,TypeError):return False

def identifier(value):
    if not isinstance(value, str) or not re.fullmatch(r'[A-Za-z][A-Za-z0-9_-]{0,63}', value):
        raise ValueError('Use a plain ID with letters, numbers, hyphens or underscores')
    return value

def integer(value, low, high):
    if type(value) is not int or not low <= value <= high:
        raise ValueError('Number outside permitted range')
    return value

def label(value):
    if not isinstance(value, str) or not 1 <= len(value) <= 80 or not all(c.isprintable() for c in value):
        raise ValueError('Use 1-80 printable characters for a name')
    return value

def atomic(path, value, mode=0o600):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=path.parent, prefix='.new-')
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, 'w') as output:
            json.dump(value, output, ensure_ascii=False, allow_nan=False)
            output.write('\n'); output.flush(); os.fsync(output.fileno())
        os.replace(name, path)
        parent = os.open(path.parent, os.O_DIRECTORY)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
    finally:
        if os.path.exists(name):
            os.unlink(name)

def read(path):
    if path.stat().st_size > MAX_BYTES:
        raise ValueError('State exceeds size limit')
    return json.loads(path.read_text())

def defaults(peers):
    return {'schema': 1, 'timezone': 'UTC', 'subjects': {
        peer: {'name': peer, 'mode': 'off', 'daily_minutes': {day: 90 for day in DAYS},
               'hours': {day: [['08:00', '20:00']] for day in DAYS}, 'grace_seconds': 180,
               'browser': {'enabled': False, 'blocked': [], 'allowed': [], 'safe_search': False}}
        for peer in peers}}

def minute(value):
    if not isinstance(value, str) or not re.fullmatch(r'(?:[01][0-9]|2[0-3]):[0-5][0-9]|24:00', value):
        raise ValueError('Use HH:MM, with 24:00 permitted only as the end')
    h, m = map(int, value.split(':')); return h*60+m

def validate(policy, enrolled, browsers=()):
    if len(json.dumps(policy).encode()) > 32768:
        raise ValueError('Policy exceeds 32 KiB')
    if not isinstance(policy, dict) or set(policy) != {'schema', 'timezone', 'subjects'} or type(policy['schema']) is not int or policy['schema'] != 1:
        raise ValueError('Unsupported policy schema')
    if not isinstance(policy['timezone'], str):
        raise ValueError('Invalid timezone')
    ZoneInfo(policy['timezone'])
    if not isinstance(policy['subjects'], dict) or set(policy['subjects']) != set(enrolled):
        raise ValueError('Policy must match locally enrolled subjects; parents cannot enroll system users remotely')
    enabled_browsers = 0
    for peer, item in policy['subjects'].items():
        identifier(peer)
        if not isinstance(item, dict) or not {'name','mode','daily_minutes','hours','grace_seconds','browser'}<=set(item) or set(item)-{'name','mode','daily_minutes','hours','grace_seconds','browser','breaks'}:
            raise ValueError('Unknown subject settings')
        label(item['name'])
        if 'breaks' in item:_break_module.settings(item['breaks'])
        if item['mode'] not in ('off', 'monitor', 'enforce'):
            raise ValueError('Mode must be off, monitor or enforce')
        integer(item['grace_seconds'], 60, 600)
        if not isinstance(item['daily_minutes'], dict) or set(item['daily_minutes']) != set(DAYS):
            raise ValueError('Specify an allowance for all seven days')
        if not isinstance(item['hours'], dict) or set(item['hours']) != set(DAYS):
            raise ValueError('Specify hours for all seven days')
        for day in DAYS:
            integer(item['daily_minutes'][day], 0, 1440)
            windows = item['hours'][day]
            if not isinstance(windows, list) or len(windows) > 8:
                raise ValueError('At most eight windows per day')
            end = -1
            for window in windows:
                if not isinstance(window, list) or len(window) != 2:
                    raise ValueError('Expected start/end hours')
                a, b = map(minute, window)
                if not end <= a < b <= 1440:
                    raise ValueError('Hours must be sorted and nonoverlapping; split overnight windows across days')
                end = b
        browser = item['browser']
        if not isinstance(browser, dict) or set(browser) != {'enabled', 'blocked', 'allowed', 'safe_search'}:
            raise ValueError('Unknown browser settings')
        if type(browser['enabled']) is not bool or type(browser['safe_search']) is not bool:
            raise ValueError('Expected browser booleans')
        for key in ('blocked', 'allowed'):
            if not isinstance(browser[key], list) or len(browser[key]) > 200:
                raise ValueError('At most 200 domains per list')
            for domain in browser[key]:
                if not isinstance(domain, str) or len(domain) > 253 or not re.fullmatch(r'[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+', domain):
                    raise ValueError('Use lowercase DNS domains, without URLs, paths, wildcards or commands')
        if browser['enabled']:
            enabled_browsers += 1
            if not browsers:
                raise ValueError('Administrator must enroll a machine-wide browser backend first')
    if enabled_browsers > 1:
        raise ValueError('Browser policies are machine-wide; use at most one browser profile per PC')
    return policy

def bedtime_skipped(policy, usage, peer, now, boot, elapsed):
    grant = usage.get('bedtime', {}).get(peer)
    if not grant or grant['timezone'] != policy['timezone']:
        return False
    day = dt.datetime.fromtimestamp(now, ZoneInfo(policy['timezone'])).date().isoformat()
    return (grant['day'] == day and day >= max(usage['days'], default=day)
            and alive({key: grant[key] for key in ('expires', 'boot', 'deadline')}, now, boot, elapsed))

def next_allowed(policy, usage, peer, now):
    """Forecast the next policy-permitted minute; never invent a reopening time."""
    zone = ZoneInfo(policy['timezone'])
    item = policy['subjects'][peer]
    if item['mode'] != 'enforce':
        return None
    high = max(usage['days'], default='0001-01-01')
    candidate = now
    forecast_boot, forecast_elapsed = boot_id(), boottime()
    # Iterate real UTC minutes so DST gaps/folds match the daemon's local-time evaluation.
    for step in range(8*24*60+1):
        local = dt.datetime.fromtimestamp(candidate, zone)
        day = local.date().isoformat()
        counter_day = max(day, high)
        used = usage['days'].get(counter_day, {}).get(peer, 0)
        limit = item['daily_minutes'][DAYS[local.weekday()]]*60 + usage['grants'].get(counter_day+'/'+peer, 0)*60
        minutes = local.hour*60+local.minute
        if (item.get('breaks',{}).get('enabled') or used < limit) and (bedtime_skipped(policy, usage, peer, candidate, forecast_boot, forecast_elapsed+candidate-now) or any(minute(a) <= minutes < minute(b) for a,b in item['hours'][DAYS[local.weekday()]])):
            return {'at': candidate, 'label': local.strftime('%a %Y-%m-%d %H:%M %Z'),
                    'timezone': policy['timezone']}
        candidate = (int(candidate)//60+1)*60
    return None

def hibernation_capability():
    """Read-only probe. CanHibernate is not a resume test or permission to enable the guard."""
    try:
        result = subprocess.run(['/usr/bin/busctl','--system','call','org.freedesktop.login1',
            '/org/freedesktop/login1','org.freedesktop.login1.Manager','CanHibernate'],
            capture_output=True,text=True,check=True,timeout=3)
        match = re.fullmatch(r's "(yes|no|challenge|na)"', result.stdout.strip())
        value = match.group(1) if match else 'unknown'
    except (OSError,subprocess.SubprocessError):
        value = 'unknown'
    return {'logind': value, 'available': value == 'yes', 'ready_for_family_lab': False,
            'note': 'Secure lock/resume integration and a real hibernate/resume acceptance test are still required.'}

def boot_id():
    return Path('/proc/sys/kernel/random/boot_id').read_text().strip()

def boottime():
    return time.clock_gettime(time.CLOCK_BOOTTIME)

def alive(grant, now, boot, elapsed):
    if not grant or now >= grant['expires']:
        return False
    return grant['boot'] != boot or elapsed < grant['deadline']

def usage_valid(value):
    if not isinstance(value, dict) or not {'days','grants','pauses','blocked_since'} <= set(value):
        raise ValueError('Invalid usage state')
    if any(not isinstance(value.get(key, {}), dict) for key in ('days','grants','pauses','blocked_since','sites')):
        raise ValueError('Invalid usage state dictionaries')
    for day, rows in value['days'].items():
        dt.date.fromisoformat(day)
        if not isinstance(rows, dict) or any(type(n) not in (int,float) or not 0 <= n <= 10**9 for n in rows.values()):
            raise ValueError('Invalid daily totals')
    for key, minutes in value['grants'].items():
        day, peer = key.split('/',1)
        dt.date.fromisoformat(day);identifier(peer);integer(minutes,0,1440)
    bedtime = value.get('bedtime', {})
    if not isinstance(bedtime, dict):
        raise ValueError('Invalid bedtime exceptions')
    for peer, grant in bedtime.items():
        identifier(peer)
        if not isinstance(grant, dict) or set(grant) != {'day','timezone','expires','boot','deadline'}:
            raise ValueError('Invalid bedtime exception')
        dt.date.fromisoformat(grant['day']); ZoneInfo(grant['timezone'])
        timer = {key: grant[key] for key in ('expires','boot','deadline')}
        usage_valid({'days': {}, 'grants': {}, 'pauses': {'timer': timer}, 'blocked_since': {}})
    for key in ('pauses','blocked_since','sites'):
        for timer in value.get(key,{}).values():
            if not isinstance(timer,dict) or set(timer) != {'expires','boot','deadline'} or not isinstance(timer['boot'],str):
                raise ValueError('Invalid persisted timer')
            for field in ('expires','deadline'):
                if type(timer[field]) not in (int,float) or not 0 <= timer[field] <= 10**12:
                    raise ValueError('Invalid persisted deadline')
    return value

class FinishEpisodes:
    """Persistent preparation only: never unlocks, terminates or powers down a PC."""
    def __init__(self, path):
        self.path = path
        self.rows = read(path) if path.exists() else {}
        if not isinstance(self.rows, dict) or len(self.rows) > 8:
            raise ValueError('Invalid finish episodes')
        for peer, row in self.rows.items():
            identifier(peer)
            if not isinstance(row, dict) or set(row) != {'id','phase','expires','deadline','boot'}:
                raise ValueError('Invalid finish episode')
            if not isinstance(row['id'], str) or not re.fullmatch('[0-9a-f]{32}', row['id']):
                raise ValueError('Invalid finish identity')
            if row['phase'] not in ('time-up','saving','blocked') or not isinstance(row['boot'], str):
                raise ValueError('Invalid finish phase')
            for key in ('expires','deadline'):
                if type(row[key]) not in (int,float) or not 0 <= row[key] <= 10**12:
                    raise ValueError('Invalid finish deadline')

    def store(self, rows):
        atomic(self.path, rows)
        self.rows = rows

    def sync(self, blocked, now, boot, elapsed):
        rows = {peer: copy.deepcopy(row) for peer,row in self.rows.items() if peer in blocked}
        for peer in blocked:
            row = rows.setdefault(peer, {'id': uuid.uuid4().hex, 'phase':'time-up',
                'expires':now+300, 'boot':boot, 'deadline':elapsed+300})
            # A different boot consumes the finish period; a reboot is not another grant.
            if row['boot'] != boot or not alive({key:row[key] for key in ('expires','boot','deadline')}, now, boot, elapsed):
                row['phase'] = 'blocked'
        if rows != self.rows:
            self.store(rows)

    def view(self, peer, now, boot, elapsed):
        row = self.rows.get(peer)
        if row is None:
            return {'episode':None, 'phase':'allowed', 'remaining':0, 'power_enabled':False}
        remaining = max(0, min(row['expires']-now, row['deadline']-elapsed)) if row['boot'] == boot else 0
        phase = row['phase'] if remaining > 0 else 'blocked'
        return {'episode':row['id'], 'phase':phase, 'remaining':remaining if phase != 'blocked' else 0,
                'power_enabled':False}

    def action(self, peer, action, episode, now, boot, elapsed):
        if action not in ('save','rest'):
            raise ValueError('Unsupported finish action')
        state = self.view(peer, now, boot, elapsed)
        if state['episode'] != episode or state['episode'] is None:
            raise ValueError('Finish episode changed; refresh before acting')
        if action == 'save' and (state['phase'] != 'time-up' or state['remaining'] <= 0):
            raise ValueError('Save period unavailable or already used')
        rows = copy.deepcopy(self.rows)
        row = rows[peer]
        row.update(phase='saving' if action == 'save' else 'blocked',
                   expires=now+180 if action == 'save' else now,
                   deadline=elapsed+180 if action == 'save' else elapsed, boot=boot)
        self.store(rows)
        return self.view(peer, now, boot, elapsed)

class Engine:
    def __init__(self, etc=ETC, data=DATA, runtime=RUNTIME):
        self.etc, self.data, self.runtime = etc, data, runtime
        self.lock = threading.RLock()
        self.config = read(etc / 'enrollment.json')
        self.current = read(data / 'policy.json')
        validate(self.current['policy'], self.config['subjects'], self.config['browsers'])
        self.state = read(data / 'usage.json') if (data / 'usage.json').exists() else {'days': {}, 'grants': {}, 'pauses': {}, 'blocked_since': {}, 'sites': {}}
        usage_valid(self.state)
        self.state.setdefault('sites', {})
        self.finishes = FinishEpisodes(data / 'finish.json')
        self.breaks = _break_module.Breaks(data/'breaks.json',read,atomic)
        self.guards = _guard_module.Guards(self.config)
        self.time_help=read(data/'time-help.json') if (data/'time-help.json').exists() else {}
        if not isinstance(self.time_help,dict) or len(self.time_help)>32:raise ValueError('Invalid time-help queue')
        for key,item in self.time_help.items():
            if not re.fullmatch('[a-f0-9]{32}',key) or set(item)!={'id','peer','parent','created'} or item['id']!=key or item['peer'] not in self.config['subjects'] or type(item['parent']) is not int or item['parent']<=0 or type(item['created']) not in (int,float):raise ValueError('Invalid time-help request')
        self.guard_trial=read(data/'guard-trial.json') if (data/'guard-trial.json').exists() else None
        if self.guard_trial is not None:
            trial=self.guard_trial
            if not isinstance(trial,dict) or set(trial)!={'peer','boot','expires','deadline','prior','protected'} or trial['peer'] not in self.config['subjects'] or not isinstance(trial['boot'],str) or type(trial['expires']) not in (int,float) or type(trial['deadline']) not in (int,float):raise ValueError('Invalid guard trial state')
        self.last_tick = None
        self.boot = boot_id()
        self.status = {}
        self.last_success = None
        self.browser_error = None
        self.last_terminated = {}
        self.generation = 0
        self.status_generation = -1

    def audit(self, who, action, details):
        path = self.data / 'audit.jsonl'
        if path.exists() and path.stat().st_size > 1024*1024:
            os.replace(path, self.data / 'audit.previous.jsonl')
        with path.open('a') as file:
            file.write(json.dumps({'time': dt.datetime.now(dt.timezone.utc).isoformat(), 'parent': who,
                                   'action': action, 'details': details}, ensure_ascii=False)+'\n')
            file.flush(); os.fsync(file.fileno())

    def authorize(self, uid):
        if uid == 0:
            return 'local-admin'
        # Reload revocations for every request. Caller cannot select their identity.
        config = read(self.etc / 'enrollment.json')
        name = config['parents'].get(str(uid))
        if not name:
            raise PermissionError('This local account is not enrolled as a policy parent')
        return name

    def learner_request(self, uid, req):
        with self.lock:
            config = read(self.etc / 'enrollment.json')
            guard_peer=config.get('guards',{}).get(str(uid))
            if guard_peer is not None:return self.guard_request(guard_peer,req)
            peers = [peer for peer,row in config['subjects'].items() if row['uid'] == uid]
            if len(peers) != 1:
                raise PermissionError('This account is not an enrolled learner')
            if isinstance(req,dict) and req.get('op')=='break-request':
                if set(req)!={'op','episode','revision','helper','change','minutes'}:raise ValueError('Unexpected break request fields')
                parent=self.config.get('parent_helpers',{}).get(req['helper'])
                if parent is None or str(parent) not in self.config['parents']:raise ValueError('This helper is not enrolled for break decisions')
                if self.last_success is None or not 0<=boottime()-self.last_success<=20 or self.status_generation!=self.generation:raise ValueError('Policy status is stale; wait for refresh')
                peer=peers[0];self.audit('learner','break-request',{'peer':peer,'helper':req['helper'],'change':req['change']})
                return self.breaks.ask(peer,parent,req['episode'],req['revision'],req['change'],req['minutes'],time.time(),self.boot,boottime())
            if not isinstance(req, dict) or req.get('op') not in ('get','save','rest'):
                raise ValueError('Unsupported learner action')
            expected = {'op'} if req['op'] == 'get' else {'op','episode'}
            if set(req) != expected:
                raise ValueError('Unexpected learner action fields')
            if self.last_success is None or not 0 <= boottime()-self.last_success <= 20 or self.status_generation != self.generation:
                raise ValueError('Policy status changed or is stale; wait for refresh')
            peer = peers[0]
            now, elapsed = time.time(), boottime()
            state = self.finishes.view(peer, now, self.boot, elapsed)
            if req['op'] != 'get':
                if not isinstance(req['episode'], str) or req['episode'] != state['episode'] or state['episode'] is None:
                    raise ValueError('Finish episode changed; refresh before acting')
                if req['op'] == 'save' and state['phase'] != 'time-up':
                    raise ValueError('Save period unavailable or already used')
                if req['op'] == 'rest' and state['phase'] == 'blocked':
                    return dict(state, next_allowed=self.status[peer]['next_allowed'])
                self.audit('learner:'+peer, 'dino-'+req['op'], {'episode':req['episode']})
                state = self.finishes.action(peer, req['op'], req['episode'], now, self.boot, elapsed)
            row = self.status[peer]
            return dict(state, next_allowed=row['next_allowed'],break_status=row.get('break'),helpers=row.get('helpers',[]),
                        break_requests=[{'id':item['id'],'status':item['status']} for item in self.breaks.state['requests'].values() if item['peer']==peer][-8:],
                        note='Preparation only: does not change login permission, session grace or power state')

    def ask_time_help(self,peer,helper):
        parent=self.config.get('parent_helpers',{}).get(helper)
        if parent is None or str(parent) not in self.config['parents']:raise ValueError('Parent is not enrolled')
        now=time.time();queue={key:item for key,item in self.time_help.items() if 0<=now-item['created']<=900}
        for item in queue.values():
            if item['peer']==peer and item['parent']==parent and now-item['created']<30:return item
        if len(queue)>=32:raise ValueError('Wait for a parent to review the current time requests')
        identifier=uuid.uuid4().hex;item={'id':identifier,'peer':peer,'parent':parent,'created':now};queue[identifier]=item
        self.audit('learner:'+peer,'time-help',{'helper':helper});atomic(self.data/'time-help.json',queue);self.time_help=queue;return item

    def guard_request(self,peer,req):
        if peer not in self.config['subjects'] or not isinstance(req,dict):raise PermissionError('Guard is not enrolled for this learner')
        healthy=self.last_success is not None and 0<=boottime()-self.last_success<=20 and self.status_generation==self.generation
        if not healthy:raise ValueError('Policy status is stale; keep the screen protected')
        if req.get('op')=='guard-help' and set(req)=={'op','helper'}:return self.ask_time_help(peer,req['helper'])
        if req.get('op')=='guard-release' and set(req)=={'op'}:
            allowed=not self.status[peer]['blocked']
            receipt=self.data/'guard-trial-result.json'
            if allowed and receipt.exists():
                result=read(receipt)
                if result['peer']==peer and result['boot']==self.boot:
                    result['release_checked']=True;atomic(receipt,result)
            return {'allowed':allowed}
        if req.get('op')=='guard-get' and set(req)=={'op'}:
            state=self.breaks.view(peer,time.time(),self.boot,boottime());row=self.status[peer]
            return dict(state,healthy=True,blocked=row['blocked'],reason=row['reason'],next_allowed=row['next_allowed'],helpers=sorted(self.config.get('parent_helpers',{})))
        if req.get('op')=='guard-protected' and set(req)=={'op','episode'}:
            result=self.breaks.protected(peer,req['episode'],time.time(),self.boot,boottime())
            if self.guard_trial is not None and self.guard_trial['peer']==peer:
                self.guard_trial['protected']=True;atomic(self.data/'guard-trial.json',self.guard_trial)
            return result
        if req.get('op')=='guard-ask' and set(req)=={'op','episode','revision','helper','change','minutes'}:
            parent=self.config.get('parent_helpers',{}).get(req['helper'])
            if parent is None or str(parent) not in self.config['parents']:raise ValueError('Parent is not enrolled')
            self.audit('guard:'+peer,'break-request',{'helper':req['helper'],'change':req['change']})
            return self.breaks.ask(peer,parent,req['episode'],req['revision'],req['change'],req['minutes'],time.time(),self.boot,boottime())
        raise PermissionError('Guard may only read its status, acknowledge protection and request a parent decision')

    def request(self, uid, req):
        with self.lock:
            who = self.authorize(uid)
            if not isinstance(req, dict):
                raise ValueError('Expected operation object')
            op = req.get('op')
            if op=='guard-active' and set(req)=={'op'}:
                if uid!=0:raise PermissionError('Guard process inspection requires the local administrator')
                return {'active':any(self.guards.covering(peer) for peer in self.guards.processes)}
            if op=='accept-guard' and set(req)=={'op','peer'}:
                if uid!=0:raise PermissionError('Guard acceptance requires the local administrator')
                result=read(self.data/'guard-trial-result.json')
                if result['peer']!=req['peer'] or result['boot']!=self.boot or not result['protected'] or not result['release_checked'] or not 0<=time.time()-result['time']<=3600 or not (self.etc/'pam-ready').exists():raise ValueError('Complete and verify a protected guard trial first')
                paths=('/usr/local/libexec/family-lab-policy','/usr/local/libexec/family_breaks.py','/usr/local/libexec/family_guard.py','/usr/local/share/family-lab/guard/shell.qml','/usr/local/share/family-lab/guard/Dino/BreakCard.qml')
                atomic(self.etc/'guard-ready',{'boot':self.boot,'accepted':time.time(),'hashes':{name:hashlib.sha256(Path(name).read_bytes()).hexdigest() for name in paths}},0o644)
                self.audit(who,op,{'peer':req['peer']})
                return {'accepted':req['peer']}
            if op=='guard-trial' and set(req)=={'op','peer','seconds'}:
                if uid!=0:raise PermissionError('Only the local administrator can start a bounded guard trial')
                peer=identifier(req['peer']);seconds=integer(req['seconds'],15,600)
