    def tick(self, active, now=None, monotonic=None, elapsed=None):
        """active contains enrolled UIDs with any user session. No idle hints trusted."""
        with self.lock:
            now = time.time() if now is None else now
            monotonic = time.monotonic() if monotonic is None else monotonic
            elapsed = boottime() if elapsed is None else elapsed
            local = dt.datetime.fromtimestamp(now, ZoneInfo(self.current['policy']['timezone']))
            today = local.date().isoformat()
            # A backward wall-clock jump cannot reset a previously observed day's allowance.
            prior_days = sorted(self.state['days'])
            counter_day = max(today, prior_days[-1]) if prior_days else today
            delta = 0 if self.last_tick is None else max(0, min(10, monotonic-self.last_tick))
            self.last_tick = monotonic
            break_policies={peer:dict(item['breaks'],enabled=item['breaks']['enabled'] and item['mode']!='off') for peer,item in self.current['policy']['subjects'].items() if 'breaks' in item}
            break_status=self.breaks.tick(break_policies,{peer for peer,row in self.config['subjects'].items() if row['uid'] in active and not self.guards.covering(peer)},delta,now,self.boot,elapsed)
            result = {}
            for peer, enrollment in self.config['subjects'].items():
                item = self.current['policy']['subjects'][peer]
                day = self.state['days'].setdefault(counter_day, {})
                used = day.get(peer, 0)
                if item['mode'] != 'off' and enrollment['uid'] in active and not self.guards.covering(peer) and break_status.get(peer,{}).get('phase')!='break':
                    used += delta
                    day[peer] = used
                allowance = item['daily_minutes'][DAYS[local.weekday()]]*60 + self.state['grants'].get(counter_day+'/'+peer, 0)*60
                mins = local.hour*60+local.minute
                skip_bedtime = bedtime_skipped(self.current['policy'], self.state, peer, now, self.boot, elapsed)
                in_hours = skip_bedtime or any(minute(a) <= mins < minute(b) for a,b in item['hours'][DAYS[local.weekday()]])
                paused = alive(self.state['pauses'].get(peer), now, self.boot, elapsed)
                has_breaks=item.get('breaks',{}).get('enabled',False)
                break_row=break_status.get(peer)
                reason = 'outside-hours' if not in_hours else 'break' if break_row and break_row['phase']!='use' else 'daily-limit' if not has_breaks and used >= allowance else ''
                blocked = item['mode'] == 'enforce' and bool(reason) and not paused
                grace_left = None
                if blocked:
                    timer = self.state['blocked_since'].setdefault(peer, {'expires': now+item['grace_seconds'],
                        'boot': self.boot, 'deadline': elapsed+item['grace_seconds']})
                    # While blocked, never restart the countdown on reconnect/restart.
                    grace_left = max(0, min(timer['expires']-now, timer['deadline']-elapsed if timer['boot'] == self.boot else timer['expires']-now))
                else:
                    self.state['blocked_since'].pop(peer, None)
                result[peer] = {'name': item['name'], 'uid': enrollment['uid'], 'mode': item['mode'],
                    'day': counter_day, 'used_seconds': round(used), 'remaining_seconds': max(0,round(item['breaks']['use_minutes']*60-(break_row['used_seconds'] if break_row else 0))) if has_breaks else max(0,round(allowance-used)),
                    'guard_covering':self.guards.covering(peer),
                    'would_block': bool(reason), 'reason': reason, 'blocked': blocked,
                    'grace_seconds': None if grace_left is None else round(grace_left), 'paused': paused,
                    'bedtime_skipped_today': skip_bedtime,
                    'logged_in': enrollment['uid'] in active,
                    'next_allowed': next_allowed(self.current['policy'], self.state, peer, now) if blocked and reason!='break' else None,
                    'break':break_row, 'helpers':sorted(self.config.get('parent_helpers',{}))}
            if self.guard_trial is not None:
                trial=self.guard_trial;peer=trial['peer'];view=self.breaks.view(peer,now,self.boot,elapsed)
                expired=trial['boot']!=self.boot or now>=trial['expires'] or elapsed>=trial['deadline'] or view['episode'] is None or (view['phase']=='break' and view['remaining_seconds']==0)
                if expired:
                    state=copy.deepcopy(self.breaks.state)
                    if trial['prior'] is None:state['learners'][peer]={'used':0,'rest':None}
                    else:state['learners'][peer]=trial['prior']
                    for item in state['requests'].values():
                        if item['peer']==peer and item['status']=='pending':item['status']='expired'
                    self.breaks.commit(state);atomic(self.data/'guard-trial-result.json',{'peer':peer,'boot':self.boot,'time':now,'protected':trial['protected'],'release_checked':False});atomic(self.data/'guard-trial.json',None);self.guard_trial=None
                    self.audit('service','guard-trial-ended',{'peer':peer})
                else:result[peer].update(mode='enforce',blocked=True,reason='break',break_status=view,guard_test=True,**{'break':view})
            self.finishes.sync({peer for peer,row in result.items() if row['blocked']}, now, self.boot, elapsed)
            # Retain 30 daily totals; detailed browsing/application data is never collected here.
            for old in sorted(self.state['days'])[:-30]:
                del self.state['days'][old]
            self.state['sites'] = {d:g for d,g in self.state['sites'].items() if alive(g,now,self.boot,elapsed)}
            self.state['grants'] = {k:v for k,v in self.state['grants'].items() if k[:10] >= min(self.state['days'])}
            self.status = result
            self.status_generation = self.generation
            atomic(self.data / 'usage.json', self.state)
