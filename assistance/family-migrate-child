#!/usr/bin/python3
"""Parent-authenticated, reviewed Omarchy migrations; never elevate child code."""
import datetime,fcntl,hashlib,json,os,pathlib,pwd,stat,subprocess,sys
BASE=pathlib.Path('/usr/share/omarchy/migrations')
MANIFEST=pathlib.Path('/etc/family-help/migrations.json')
CONFIG=pathlib.Path('/etc/family-help/teaching.json')
def trusted(path):
    for part in (path,*path.parents):
        st=part.lstat()
        if stat.S_ISLNK(st.st_mode) or st.st_uid!=0 or st.st_mode&0o022:
            raise ValueError('Untrusted managed path: '+str(part))
def updater_running():
    for proc in pathlib.Path('/proc').glob('[0-9]*/cmdline'):
        try:args=proc.read_bytes().split(b'\0')
        except (OSError,PermissionError):continue
        if any(pathlib.PurePosixPath(os.fsdecode(arg)).name in ('omarchy-update','omarchy-update-system-pkgs','pacman','dkms','mkinitcpio','limine-mkinitcpio') for arg in args[:3]):
            return True
    return pathlib.Path('/var/lib/pacman/db.lck').exists()
def clean_env(user):
    return {'HOME':user.pw_dir,'USER':user.pw_name,'LOGNAME':user.pw_name,'PATH':'/usr/bin:/bin',
            'LANG':'C.UTF-8','TERM':'xterm-256color','OMARCHY_PATH':'/usr/share/omarchy'}
def child_command(user,command):
    # No parent environment, sudo timestamp, SSH agent, or root descriptors.
    env=clean_env(user)
    runtime='/run/user/'+str(user.pw_uid)
    if pathlib.Path(runtime).is_dir():
        env.update(XDG_RUNTIME_DIR=runtime,DBUS_SESSION_BUS_ADDRESS='unix:path='+runtime+'/bus')
    return subprocess.run(['/usr/bin/setpriv','--reuid='+str(user.pw_uid),'--regid='+str(user.pw_gid),
        '--init-groups','--no-new-privs','/usr/bin/env','-i',*[k+'='+v for k,v in env.items()],*command],
        cwd=user.pw_dir,close_fds=True,env=clean_env(pwd.getpwuid(0))).returncode
MARKER_CODE='''import os,pathlib,sys
p=pathlib.Path.home()/'.local/state/omarchy/migrations'
p.mkdir(parents=True,exist_ok=True)
(p/sys.argv[1]).touch()
'''
def inspect(user,manifest):
    result=subprocess.run(['/usr/bin/setpriv','--reuid='+str(user.pw_uid),'--regid='+str(user.pw_gid),
        '--init-groups','--no-new-privs','/usr/bin/env','-i','HOME='+user.pw_dir,'PATH=/usr/bin:/bin',
        '/usr/bin/python3','-c',"import pathlib,json; p=pathlib.Path.home()/'.local/state/omarchy/migrations'; print(json.dumps([x.name for x in pathlib.Path('/usr/share/omarchy/migrations').glob('*.sh') if not (p/x.name).is_file()]))"],
        cwd='/',capture_output=True,text=True,check=True)
    pending=sorted(json.loads(result.stdout));plans=[]
    for name in pending:
        path=BASE/name;trusted(path);digest=hashlib.sha256(path.read_bytes()).hexdigest()
        rule=manifest.get(name)
        plans.append({'name':name,'sha256':digest,'action':rule['action'] if rule and rule['sha256']==digest else 'REVIEW REQUIRED'})
    return plans
def main():
    if len(sys.argv)!=2 or sys.argv[1] not in ('plan','apply'):sys.exit('Usage: sudo family-migrate-child plan|apply')
    if os.geteuid()!=0:sys.exit('Parent administrator authentication is required')
    trusted(CONFIG);cfg=json.loads(CONFIG.read_text())
    if os.environ.get('SUDO_USER')!=cfg['admin'] or not os.isatty(0):sys.exit('Use the private parent administrator terminal with sudo')
    trusted(MANIFEST);manifest=json.loads(MANIFEST.read_text());user=pwd.getpwnam(cfg['child'])
    if user.pw_uid==0 or user.pw_name==cfg['admin']:sys.exit('Invalid child identity')
    folder=pathlib.Path('/run/family-help-updates');folder.mkdir(mode=0o700,exist_ok=True);trusted(folder)
    with (folder/'lock').open('a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
        plans=inspect(user,manifest)
        print(json.dumps({'child':user.pw_name,'busy':updater_running(),'pending':plans},indent=2),flush=True)
        if sys.argv[1]=='plan':return
        if updater_running():sys.exit('An update/build is still running. Finish it before applying migrations.')
        if any(x['action']=='REVIEW REQUIRED' for x in plans):sys.exit('New or changed migrations require review; nothing was applied.')
        if not plans:
            print('Child migrations already complete; no changes or new audit file.');return
        audit=pathlib.Path('/var/lib/family-help/updates');audit.mkdir(mode=0o700,parents=True,exist_ok=True);trusted(audit)
        record={'time':datetime.datetime.now(datetime.timezone.utc).isoformat(),'child':user.pw_name,'results':[]}
        log=audit/(datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S')+'-'+str(os.getpid())+'.json')
        os.umask(0o077)
        for item in plans:
            path=BASE/item['name'];trusted(path)
            if hashlib.sha256(path.read_bytes()).hexdigest()!=item['sha256']:sys.exit('Migration changed during review')
            print('\nApplying '+item['name']+' ('+item['action']+')',flush=True)
            if item['action']=='system':
                parent=pwd.getpwnam(cfg['admin'])
                completed=pathlib.Path(parent.pw_dir)/'.local/state/omarchy/migrations'/item['name']
                if completed.is_file():
                    print('Already completed by the parent updater; recording child completion.',flush=True)
                    code=0;item['system_reused']=True
                else:
                    code=subprocess.run(['/usr/bin/bash','-euo','pipefail',str(path)],cwd='/root',env=clean_env(pwd.getpwuid(0)),close_fds=True).returncode
            elif item['action']=='split-browser':
                source=path.read_text();prefix,separator,suffix=source.partition('source "$OMARCHY_PATH/install/helpers/browser-policy.sh"')
                if not separator:sys.exit('Browser migration layout changed')
                code=subprocess.run(['/usr/bin/bash','-euo','pipefail','-c',separator+suffix],cwd='/root',env=clean_env(pwd.getpwuid(0)),close_fds=True).returncode
                if code==0:code=child_command(user,['/usr/bin/bash','-euo','pipefail','-c',prefix])
            else:
                code=child_command(user,['/usr/bin/bash','-euo','pipefail',str(path)])
            if code==0:code=child_command(user,['/usr/bin/python3','-c',MARKER_CODE,item['name']])
            record['results'].append(dict(item,returncode=code));log.write_text(json.dumps(record,indent=2))
            if code:sys.exit('Migration stopped; later migrations remain pending. Audit: '+str(log))
        remaining=inspect(user,manifest)
        if remaining:sys.exit('Additional pending migrations remain; rerun plan')
        print('Child migrations complete. No child sudo permission was added. Audit: '+str(log),flush=True)
if __name__=='__main__':
    try:main()
    except (OSError,ValueError,subprocess.SubprocessError) as exc:sys.exit(str(exc))
