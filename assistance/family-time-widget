#!/usr/bin/python3
"""Parent screen-time cards; all authority stays on the child policy service."""
import copy,threading,datetime as dt
from zoneinfo import ZoneInfo
import gi
gi.require_version('Gtk','4.0');gi.require_version('Gdk','4.0')
from gi.repository import Gtk,Gdk,GLib,GObject
from family_identity import helper_config
from family_policy_client import request,report
from family_theme import themed_css
DAYS=('mon','tue','wed','thu','fri','sat','sun')
def theme_css(home=None):
    # Share the Ask Dad layout and map its color roles to the active theme.
    return themed_css(b"""
    .family-time { background: #101820; color: #d9e5ee; font-family: monospace; font-size: 12px; }
    .family-time .heading { color: #74e0c3; font-size: 21px; font-weight: bold; }
    .family-time .feedback { color: #70d5ff; }
    .family-time entry, .family-time spinbutton, .family-time dropdown { background: #192733; color: #edf6ff; border: 1px solid #3e586b; border-radius: 6px; min-height: 25px; }
    .family-time entry { padding: 3px 8px; }
    .family-time button { background: #20313e; color: #e1edf5; border: 1px solid #425c70; border-radius: 6px; padding: 7px 10px; }
    .family-time button:hover { background: #2a4252; }
    .family-time .primary { background: #183f3a; color: #95f5d7; border-color: #58b99a; font-weight: bold; }
    .family-time .footer { background: #101820; border-top: 1px solid #345266; padding: 12px 16px; }
    .family-time selection { background: #2a4252; color: #edf6ff; }
    """,home)

class App(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='org.familylab.ParentTime');self.connect('activate',self.activate);self.config=helper_config();self.busy=False;self.controls=[]
    def label(self,text):
        node=Gtk.Label(label=text,xalign=0,wrap=True);self.box.append(node);return node
    def button(self,text,callback,parent=None):
        button=Gtk.Button(label=text);button.connect('clicked',lambda *_:callback());(self.box if parent is None else parent).append(button);self.controls.append(button);return button
    def update_theme(self):
        css=theme_css()
        if css!=getattr(self,'last_css',None):self.css.load_from_data(css);self.last_css=css
        return True
    def activate(self,*_):
        if self.get_active_window():self.get_active_window().present();return
        self.css=Gtk.CssProvider();self.update_theme()
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(),self.css,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        GLib.timeout_add_seconds(3,self.update_theme)
        self.win=Gtk.ApplicationWindow(application=self,title='Family breaks and bedtime',default_width=640,default_height=740)
        self.win.set_decorated(False);self.win.add_css_class('family-time')
        self.box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=7,margin_top=18,margin_bottom=18,margin_start=20,margin_end=20)
        layout=Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        scroll=Gtk.ScrolledWindow(vexpand=True);scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.ALWAYS);scroll.set_child(self.box)
        self.footer=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=8);self.footer.add_css_class('footer')
        self.feedback=Gtk.Label(label='Connecting to the policy service…',xalign=0,wrap=True,margin_start=16,margin_end=16,margin_top=8,margin_bottom=8)
        self.feedback.add_css_class('feedback')
        self.top_feedback=Gtk.Label(xalign=0,wrap=True,margin_start=20,margin_end=20,margin_top=12,margin_bottom=8)
        self.top_feedback.add_css_class('feedback')
        self.feedback.bind_property('label',self.top_feedback,'label',GObject.BindingFlags.SYNC_CREATE)
        layout.append(self.top_feedback)
        layout.append(scroll);layout.append(self.feedback);layout.append(self.footer);self.win.set_child(layout)
        self.button('Retry connection',self.refresh,self.footer).add_css_class('primary')
        self.button('Close',self.win.close,self.footer)
        self.win.present();self.refresh()
    def run_task(self,work,done,quiet=False):
        if self.busy:
            self.feedback.set_text('A request is still running. Please wait for its confirmation.');return
        self.busy=True
        for control in self.controls:control.set_sensitive(False)
        if not quiet:self.feedback.set_text('Working…')
        def worker():
            try:value,error=work(),None
            except Exception as exc:value,error=None,str(exc)[:500]
            def finish():
                self.busy=False
                for control in self.controls:control.set_sensitive(True)
                if error:self.feedback.set_text('Could not confirm the result: '+error)
                else:done(value)
                return False
            GLib.idle_add(finish)
        threading.Thread(target=worker,daemon=True).start()
    def refresh(self):self.run_task(lambda:request({'op':'get'}),self.render)
    def render(self,data):
        self.snapshot=data;self.controls=[];peer=self.config['policy_peer'];subject=data['policy']['subjects'][peer]
        child=self.box.get_first_child()
        while child:
            nxt=child.get_next_sibling();self.box.remove(child);child=nxt
        child=self.footer.get_first_child()
        while child:
            nxt=child.get_next_sibling();self.footer.remove(child);child=nxt
        self.label('$ family-time').add_css_class('heading')
        self.feedback.set_text('Connected' if data.get('healthy') else 'Service is starting or unhealthy; do not rely on enforcement yet.')
        self.label(subject['name']+' · revision '+str(data['revision']))
        state=data['status'].get(peer,{})
        self.label('Mode: '+subject['mode']+' | timezone: '+data['policy']['timezone'])
        self.label(f"Used today: {state.get('used_seconds',0)//60} min | Until next break: {state.get('remaining_seconds',0)//60} min")
        if state.get('reason'):self.label('Current restriction: '+state['reason'])
        if state.get('next_allowed'):self.label('Next access: '+str(state['next_allowed']))
        self.label('Bedtime today: '+('SKIPPED until local midnight' if state.get('bedtime_skipped_today') else 'Normal allowed hours'))
        self.label('BREAKS  /  Work stays open · Bedtime is separate')
        if not data.get('capabilities',{}).get('protected_break_guard'):self.label('Enforcement awaits live Dino acceptance.')
        self.label('Computer use before a break (minutes)')
        self.use=Gtk.SpinButton.new_with_range(1,240,5);self.use.set_value(subject.get('breaks',{}).get('use_minutes',60));self.box.append(self.use);self.controls.append(self.use)
        self.label('Break duration (minutes)')
        self.rest=Gtk.SpinButton.new_with_range(1,120,5);self.rest.set_value(subject.get('breaks',{}).get('break_minutes',15));self.box.append(self.rest);self.controls.append(self.rest)
        self.fields={}
        for day in DAYS:
            row=Gtk.Box(spacing=8);self.box.append(row);row.append(Gtk.Label(label=day.title(),width_chars=4))
            minutes=None
            hours=Gtk.Entry(placeholder_text='08:00-20:00; empty means no access',hexpand=True)
            hours.set_text(', '.join(a+'-'+b for a,b in subject['hours'][day]));row.append(hours);self.fields[day]=(minutes,hours);self.controls.append(hours)
        self.timezone=Gtk.Entry(text=data['policy']['timezone']);self.box.append(self.timezone);self.controls.append(self.timezone)
        self.label('Mode - choose one, then apply all settings below')
        self.mode_buttons={}
        group=None
        for mode,title in [('off','Off - no time restrictions'),('monitor','Monitor - record time only'),('enforce','Enforce - apply breaks and bedtime')]:
            choice=Gtk.CheckButton(label=title)
            if group is not None:choice.set_group(group)
            else:group=choice
            choice.set_active(mode==subject['mode'])
            if mode=='enforce' and not data.get('capabilities',{}).get('protected_break_guard'):
                choice.set_sensitive(False)
            else:self.controls.append(choice)
            self.mode_buttons[mode]=choice;self.box.append(choice)
        self.button('Apply mode, breaks and allowed hours',self.apply,self.footer).add_css_class('primary')
        current=state.get('break')
        if current and current['episode']:
            for title,change,minutes in [('Skip this break','skip',0),('Shorten this break by 5 minutes','shorten',5),('Extend this break by 5 minutes','extend',5)]:
                self.button(title,lambda change=change,minutes=minutes:self.operation({'op':'break-adjust','peer':peer,'episode':current['episode'],'revision':current['revision'],'change':change,'minutes':minutes}))
        bedtime=Gtk.Box(spacing=8,homogeneous=True);self.footer.append(bedtime)
        for title,op in [('Skip bedtime today',{'op':'bedtime-today','enabled':True}),('Restore bedtime today',{'op':'bedtime-today','enabled':False})]:
            self.button(title,lambda op=op:self.operation(dict(op,peer=peer)),bedtime)
        tools=Gtk.Box(spacing=8,homogeneous=True);self.footer.append(tools)
        self.button('Save private time report',lambda:self.run_task(lambda:report(request({'op':'summary'}),peer),lambda path:self.feedback.set_text('Saved private report: '+str(path))),tools)
        self.button('Refresh',self.refresh,tools)
        self.button('Close',self.win.close,tools)
        self.run_task(lambda:request({'op':'break-pending'}),self.pending,quiet=True)
    def pending(self,result):
        for item in result['requests']:
            self.label('Break request: '+item['change']+(' '+str(item['minutes'])+' minutes' if item['minutes'] else '')+' — '+item['peer'])
            self.button('Approve this break change',lambda item=item:self.operation({'op':'break-decision','id':item['id'],'decision':'approve'}))
            self.button('Deny this break change',lambda item=item:self.operation({'op':'break-decision','id':item['id'],'decision':'deny'}))
    def operation(self,operation):
        peer=self.config['policy_peer']
        def save_and_read():
            receipt=request(operation)
            data=request({'op':'get'})
            if operation['op']=='apply':
                if receipt.get('revision')!=data.get('revision') or data.get('policy')!=operation.get('policy'):
                    raise ValueError('Saved settings do not match your selection, or another parent changed them. Your edits are retained; refresh and review before applying again.')
                message='Confirmed: mode '+data['policy']['subjects'][peer]['mode']+'; breaks and hours saved (revision '+str(data['revision'])+').'
            elif operation['op']=='bedtime-today':
                if receipt.get('accepted') is not True or receipt.get('enabled') is not operation['enabled']:
                    raise ValueError('The service did not confirm the bedtime change')
                if operation['enabled']:
                    end=dt.datetime.fromtimestamp(receipt['expires'],ZoneInfo(data['policy']['timezone']))
                    message='Bedtime skipped until '+end.strftime('%a %b %d, %I:%M %p %Z')+'. Breaks still apply.'
                else:message='Normal bedtime hours restored for today.'
            else:message='Change confirmed by the policy service.'
            return data,message
        def saved(result):
            data,message=result
            self.render(data)
            self.feedback.set_text(message)
        self.run_task(save_and_read,saved)
    def apply(self):
        try:
            policy=copy.deepcopy(self.snapshot['policy']);item=policy['subjects'][self.config['policy_peer']]
            modes=[mode for mode,button in self.mode_buttons.items() if button.get_active()]
            if len(modes)!=1:raise ValueError('Choose one mode before applying')
            mode=modes[0]
            item['breaks']={'enabled':True,'use_minutes':self.use.get_value_as_int(),'break_minutes':self.rest.get_value_as_int()}
            policy['timezone']=self.timezone.get_text().strip();item['mode']=mode
            for day,(minutes,hours) in self.fields.items():
                text=hours.get_text().strip();windows=[]
                for value in text.split(',') if text else []:
                    parts=value.strip().split('-')
                    if len(parts)!=2:raise ValueError('Use HH:MM-HH:MM windows separated by commas')
                    windows.append(parts)
                item['hours'][day]=windows
            self.operation({'op':'apply','base_revision':self.snapshot['revision'],'policy':policy})
        except (ValueError,KeyError) as exc:self.feedback.set_text(str(exc))
if __name__=='__main__':App().run()
