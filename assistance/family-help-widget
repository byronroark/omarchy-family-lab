#!/usr/bin/python3
"""Terminal-styled local help windows. All actions are explicit and unprivileged."""
import hashlib,json,os,pathlib,re,shutil,subprocess,sys,threading,time,uuid
import gi
gi.require_version('Gtk','4.0');gi.require_version('Gdk','4.0')
from gi.repository import Gtk,Gdk,GLib
from family_help_image import bounded_command,bounded_file,normalize_png,prune
from family_identity import helper_config,identity
os.umask(0o077)
PARENT_PANEL=len(sys.argv)>1 and sys.argv[1] in ('dad','helper')
IDENTITY_CONFIG=helper_config() if PARENT_PANEL else json.loads(pathlib.Path('/etc/family-help/child.json').read_text())
HELPER,HELPER_SLUG=identity(IDENTITY_CONFIG)
CSS=b'''
.family-help { background: #101820; color: #d9e5ee; font-family: monospace; }
.family-help .heading { color: #74e0c3; font-size: 21px; font-weight: bold; }
.family-help .muted { color: #91a5b5; font-size: 12px; }
.family-help .prompt { color: #70d5ff; font-weight: bold; }
.family-help .status { color: #74e0c3; font-size: 12px; }
.family-help entry { background: #192733; color: #edf6ff; border: 1px solid #3e586b; border-radius: 7px; padding: 11px; }
.family-help button { background: #20313e; color: #e1edf5; border: 1px solid #425c70; border-radius: 6px; padding: 9px 12px; }
.family-help button:hover { background: #2a4252; }
.family-help button:disabled { color: #6b8090; border-color: #283b49; }
.family-help .primary { background: #183f3a; color: #95f5d7; border-color: #58b99a; font-weight: bold; }
.family-help .danger { color: #ffb9a9; }
.family-help frame { border: 1px solid #345266; border-radius: 8px; padding: 9px; }
'''
def read(path):
    try:
        data=json.loads(bounded_file(path,2048));return data if isinstance(data,dict) else {}
    except (OSError,ValueError,RecursionError):return {}
def helper(mode):return ['/usr/local/libexec/family-help-child',mode]
class HelpApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='org.familylab.HelpDad' if PARENT_PANEL else 'org.familylab.Help',flags=0)
        self.image=None;self.draft=None;self.busy=False;self.pasting=False
    def do_activate(self):
        if self.get_active_window():self.get_active_window().present();return
        css=Gtk.CssProvider();css.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(),css,Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.win=Gtk.ApplicationWindow(application=self,title='Family Help' if PARENT_PANEL else 'Ask '+HELPER)
        self.win.set_default_size(650,580);self.win.set_resizable(False);self.win.add_css_class('family-help')
        self.win.connect('close-request',self.cleanup)
        box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=13)
        for side in ('top','bottom','start','end'):getattr(box,'set_margin_'+side)(22)
        self.win.set_child(box);self.box=box
        self.label('$ family-help' if PARENT_PANEL else '$ ask-'+HELPER_SLUG,'heading')
        if PARENT_PANEL:self.build_parent()
        else:self.build_child()
        self.win.present()
    def label(self,text,style='',parent=None):
        item=Gtk.Label(label=text,xalign=0);item.set_wrap(True)
        if style:item.add_css_class(style)
        (parent or self.box).append(item);return item
    def button(self,text,callback,parent=None,style=''):
        item=Gtk.Button(label=text);item.connect('clicked',lambda *_:callback())
        if style:item.add_css_class(style)
        (parent or self.box).append(item);return item
    def row(self):
        row=Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL,spacing=8);self.box.append(row);return row
    def status(self,text):self.feedback.set_text(text);return False
    def background(self,work,done):
        def run():
            try:result=work();GLib.idle_add(done,result,None)
            except Exception as exc:GLib.idle_add(done,None,str(exc))
        threading.Thread(target=run,daemon=True).start()
    def build_child(self):
        self.cfg=json.loads(pathlib.Path('/etc/family-help/child.json').read_text())
        if os.getuid()!=self.cfg['uid']:raise ValueError('Open this from the child account')
        self.state=pathlib.Path(self.cfg['state']);(self.state/'drafts').mkdir(parents=True,mode=0o700,exist_ok=True)
        self.label('> What do you need?','prompt')
        row=self.row();self.choices=[]
        for topic,label in [('help','Help me'),('watch','Watch me'),('admin','Admin task')]:
            item=Gtk.CheckButton(label=label)
            if self.choices:item.set_group(self.choices[0][1])
            else:item.set_active(True)
            self.choices.append((topic,item));row.append(item)
        self.entry=Gtk.Entry();self.entry.set_max_length(300);self.entry.set_placeholder_text(f"What would you like {HELPER}'s help with?");self.box.append(self.entry)
        self.label('> Screenshot (optional)','prompt')
        self.frame=Gtk.Frame();self.frame.set_size_request(-1,155)
        self.picture=Gtk.Picture();self.picture.set_can_shrink(True);self.picture.set_size_request(580,145)
        self.placeholder=Gtk.Label(label='Copy a screenshot, then press Ctrl+V here.')
        self.frame.set_child(self.placeholder);self.box.append(self.frame)
        row=self.row();self.button('Capture region',self.capture,row);self.button('Paste screenshot',self.paste,row);self.button('Remove',self.clear_image,row)
        self.image_label=Gtk.Label(label='Nothing attached',xalign=0);self.image_label.add_css_class('muted');row.append(self.image_label)
        self.feedback=self.label(f'Only the message and screenshot you send go to {HELPER}.','status')
        row=self.row();self.send_button=self.button(f'Ask {HELPER}  [Ctrl+Enter]',self.send,row,'primary')
        self.button('Close',self.win.close,row)
        self.label('> Learning controls','prompt');row=self.row()
        self.button('Start learning',lambda:self.action('learn',terminal=True),row)
        self.allow=self.button(f'Let {HELPER} type',lambda:self.action('allow'),row)
        self.stop=self.button(f'Stop {HELPER} typing',lambda:self.action('revoke'),row,'danger')
        self.watch=self.button(f'Watch {HELPER}',lambda:self.action('demo-view',terminal=True),row)
        self.live=self.label('','muted');self.refresh();GLib.timeout_add(1000,self.refresh)
        keys=Gtk.EventControllerKey();keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE);keys.connect('key-pressed',self.key);self.win.add_controller(keys)
    def key(self,_controller,keyval,_keycode,modifiers):
        if modifiers&Gdk.ModifierType.CONTROL_MASK and keyval in (Gdk.KEY_v,Gdk.KEY_V):
            formats=Gdk.Display.get_default().get_clipboard().get_formats()
            if formats.contain_mime_type('image/png'):self.paste();return True
        if modifiers&Gdk.ModifierType.CONTROL_MASK and keyval in (Gdk.KEY_Return,Gdk.KEY_KP_Enter):self.send();return True
        if keyval==Gdk.KEY_Escape:self.win.close();return True
        return False
    def refresh(self):
        if not self.win.get_visible():return True
        now=time.time();request=read(self.state/'control-request.json');grant=read(self.state/'consent.json');demo=read(pathlib.Path('/run/family-help-demo/active.json'))
        waiting=bool(request and 0<=now-request.get('time',0)<=600)
        allowed=bool(grant and grant.get('id')==request.get('id') and grant.get('expires',0)>now)
        self.allow.set_sensitive(waiting and not allowed);self.stop.set_sensitive(allowed)
        self.watch.set_sensitive(bool(demo and demo.get('expires',0)>now))
        self.live.set_text(f'{HELPER} can type. You can stop typing access here.' if allowed else f'{HELPER} is asking to type. Choose Let {HELPER} type if you want help.' if waiting else f'{HELPER} can only watch until you allow typing.')
        return True
    def paste(self):
        if self.busy or self.pasting:return
        self.pasting=True;self.status('Reading screenshot from the clipboard…')
        def work():return normalize_png(bounded_command(['/usr/bin/wl-paste','--no-newline','--type','image/png']))
        def done(result,error):
            self.pasting=False
            if error:return self.status(error)
            self.image,meta=result
            if self.draft:self.draft.unlink(missing_ok=True)
            self.draft=self.state/'drafts'/(uuid.uuid4().hex+'.png');self.draft.write_bytes(self.image)
            self.picture.set_filename(str(self.draft));self.frame.set_child(self.picture)
            self.image_label.set_text(f"{meta['width']} × {meta['height']} • {meta['bytes']//1024} KB")
            return self.status(f'Screenshot ready. It is sent only when you choose Ask {HELPER}.')
        self.background(work,done)
    def capture(self):
        if self.busy or self.pasting:return
        self.pasting=True;self.status(f'Select the region you want {HELPER} to see.')
        self.hold();self.win.set_visible(False)
        def work():
            try:before=hashlib.sha256(bounded_command(['/usr/bin/wl-paste','--no-newline','--type','image/png'],seconds=3)).digest()
            except (OSError,ValueError,subprocess.SubprocessError):before=None
            # A user-clicked capture only. No background or automatic screenshots.
            result=subprocess.run([shutil.which('omarchy') or '/usr/bin/omarchy','capture','screenshot','region','copy'],
                                  stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=120)
            if result.returncode:raise ValueError('Capture cancelled. Your previous attachment was kept.')
            image=bounded_command(['/usr/bin/wl-paste','--no-newline','--type','image/png'])
            if hashlib.sha256(image).digest()==before:raise ValueError('No new screenshot was copied. Try Capture region again, or paste your clipboard image.')
            return normalize_png(image)
        def done(result,error):
            self.pasting=False;self.win.present();self.release()
            if error:return self.status(error)
            self.image,meta=result
            if self.draft:self.draft.unlink(missing_ok=True)
            self.draft=self.state/'drafts'/(uuid.uuid4().hex+'.png');self.draft.write_bytes(self.image)
            self.picture.set_filename(str(self.draft));self.frame.set_child(self.picture)
            self.image_label.set_text(f"{meta['width']} × {meta['height']} • {meta['bytes']//1024} KB")
            return self.status(f'Screenshot ready. It is sent only when you choose Ask {HELPER}.')
        self.background(work,done)
    def clear_image(self):
        self.image=None
        if self.draft:self.draft.unlink(missing_ok=True);self.draft=None
        self.frame.set_child(self.placeholder);self.image_label.set_text('Nothing attached')
    def send(self):
        if self.busy or self.pasting:return
        text=self.entry.get_text().strip()
        if not text or any(not c.isprintable() for c in text):return self.status('Write a short, single-line message first.')
        payload={'message':text,'topic':next(topic for topic,item in self.choices if item.get_active())}
        if self.draft:payload['draft']=self.draft.stem
        self.busy=True;self.send_button.set_sensitive(False);self.status('Sending your request…')
        def work():
            result=subprocess.run(helper('send-widget'),input=json.dumps(payload),capture_output=True,text=True,timeout=15)
            if result.returncode:raise ValueError(result.stderr.strip().splitlines()[-1] if result.stderr.strip() else 'Could not send; please try again.')
            return result.stdout.strip()
        def done(result,error):
            self.busy=False;self.send_button.set_sensitive(True)
            if not error:self.clear_image()
            return self.status(error or f'Sent to {HELPER}’s PC for collection. This is not a read receipt.')
        self.background(work,done)
    def action(self,mode,terminal=False):
        if terminal:
            subprocess.Popen(['/usr/bin/omarchy-launch-terminal','/usr/bin/env','TERM=xterm-256color',*helper(mode)],start_new_session=True,
                             stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
        else:
            def work():
                r=subprocess.run(helper(mode),capture_output=True,text=True,timeout=5)
                if r.returncode:raise ValueError(r.stderr.strip() or 'That action is not available right now.')
                return r.stdout.strip()
            self.background(work,lambda result,error:self.status(error or result))
    def build_parent(self):
        identifier=sys.argv[2]
        if not re.fullmatch('[a-f0-9]{32}',identifier):raise ValueError('Invalid request')
        state=pathlib.Path.home()/'.local/state/family-help';data=read(state/'requests'/(identifier+'.json'))
        label=IDENTITY_CONFIG['label']
        self.label('Help requested: '+label,'prompt')
        self.label({'help':'Help me','watch':'Watch me','admin':'Admin task'}.get(data.get('topic'),'Help me'),'muted')
        self.label(data['message'])
        if IDENTITY_CONFIG.get('capability','technical')=='approver':
            return self.build_approver(data)
        if 'software' in data:
            from family_software import validate_request
            validate_request(data)
            request=data['software']
            title='SYSTEM UPDATE' if request['action']=='update' else 'INSTALL REQUEST'
            manual=False
            if request['action']=='menu':
                from family_menu import entry
                item=entry(request['menu']);manual=item['mode']=='manual'
                title=item['title']+' — '+('MANUAL REVIEW' if manual else 'MENU ACTION')
                self.label(request['menu'],'muted')
                if item.get('notice'):self.label(item['notice'],'muted')
            self.label(title,'prompt')
            if request['packages']:self.label('\n'.join(request['packages']))
            self.label('Approval expires after 15 minutes.\nApprove opens your private administrator terminal for authentication and transaction review.','muted')
            row=self.row()
            if manual:self.label('This action needs hands-on review. Accepting records the request; it does not run the installer.','muted')
            self.button(f'Review with {HELPER}' if manual else 'Review and approve',lambda:self.choose('approve'),row,'primary')
            self.button('Deny request',lambda:self.choose('deny'),row,'danger')
            self.button('Dismiss',lambda:self.choose('dismiss'),row)
            return
        image=state/'screenshots'/(identifier+'.png')
        if data.get('screenshot') and image.exists():
            picture=Gtk.Picture.new_for_filename(str(image));picture.set_can_shrink(True);picture.set_size_request(590,240)
            frame=Gtk.Frame();frame.set_child(picture);self.box.append(frame)
            self.button('View full screenshot',lambda:subprocess.Popen(['/usr/bin/imv',str(image)],start_new_session=True))
        elif data.get('screenshot'):self.label('Screenshot unavailable. You can still help with the message.','muted')
        self.label('Help together needs your child’s permission.\nAdmin demonstration asks for your password privately.','muted')
        self.label('This request stays until you choose an action.','status')
        row=self.row()
        for action,label in [('help','Help together'),('admin','Admin demonstration'),('watch','Watch only'),('dismiss','Dismiss')]:
            self.button(label,lambda action=action:self.choose(action),row,'primary' if action=='help' else '')
    def build_approver(self,data):
        if 'software' not in data:
            self.label('This request needs the technical helper. Your account can approve app installs but cannot open an admin or typing session.','muted')
            self.button('Dismiss',lambda:self.choose('dismiss'),self.row());return
        path=pathlib.Path.home()/'.local/state/family-help/reviews'/(data['id']+'.json')
        self.review=json.loads(bounded_file(path,65536))
        if self.review.get('already_decided') and self.review.get('id')==data['id']:
            self.approval_id=data['id'];return self.build_approval_status('Status: '+self.review['status'])
        if self.review.get('id')!=data['id'] or self.review.get('expires',0)<=time.time():raise ValueError('Approval review expired; reopen the request')
        plan=self.review['plan'];self.approval_id=data['id']
        self.label(plan['title'],'prompt');self.label(plan['reason'],'muted')
        if plan.get('requested'):self.label('Requested: '+', '.join(plan['requested']),'muted')
        if plan.get('transaction'):
            self.label('Exact packages, including dependencies:','prompt')
            scroll=Gtk.ScrolledWindow();scroll.set_min_content_height(130);scroll.set_max_content_height(180)
            details=Gtk.Label(label='\n'.join(plan['transaction']),xalign=0);details.set_selectable(True)
            scroll.set_child(details);self.box.append(scroll)
        elif plan.get('supported'):self.label('Packages are already installed; any reviewed app setup still runs.','muted')
        self.label('Approval is limited to this reviewed request. You do not need an administrator password.','muted')
        self.approval_feedback=self.label('','status');row=self.row();self.approval_buttons=[]
        if plan.get('supported'):self.approval_buttons.append(self.button('Approve installation',lambda:self.choose('approve'),row,'primary'))
        self.approval_buttons.append(self.button('Deny request',lambda:self.choose('deny'),row,'danger'))
        self.button('Dismiss',lambda:self.choose('dismiss'),row)
    def build_approval_status(self,status):
        child=self.box.get_first_child()
        while child is not None:self.box.remove(child);child=self.box.get_first_child()
        self.label('Request status','prompt');self.approval_feedback=self.label(status,'status')
        self.label('The child can see the result too. Closing this window does not cancel a queued or running install.','muted')
        self.button('Close',self.win.close,self.row())
        self.status_deadline=time.monotonic()+1800
        GLib.timeout_add(2000,self.poll_approval_status)
    def poll_approval_status(self):
        if self.busy:return True
        if time.monotonic()>self.status_deadline:return False
        from family_approval_client import rpc
        self.busy=True
        def done(result,error):
            self.busy=False
            if error:self.approval_feedback.set_text(error);return
            status=result['status'];self.approval_feedback.set_text('Status: '+status)
            if status in ('completed','failed','denied','interrupted'):self.status_deadline=0
        self.background(lambda:rpc(IDENTITY_CONFIG,{'op':'status','id':self.approval_id}),done)
        return True
    def choose(self,action):
        if IDENTITY_CONFIG.get('capability','technical')=='approver' and action in ('approve','deny'):
            if self.busy:return
            from family_approval_client import decision
            self.busy=True
            for button in self.approval_buttons:button.set_sensitive(False)
            self.approval_feedback.set_text('Sending your decision…')
            def done(result,error):
                self.busy=False
                if error:
                    self.approval_feedback.set_text(error+' The decision could not be confirmed. Check status before trying again.')
                    self.button('Check request status',lambda:self.build_approval_status('Checking status…'),self.row())
                else:self.build_approval_status('Status: '+result['status'])
            self.background(lambda:decision(IDENTITY_CONFIG,self.review,action),done)
            return
        print(action,flush=True);self.win.close()
    def cleanup(self,*_args):
        if self.draft:self.draft.unlink(missing_ok=True)
        return False
app=HelpApp()
raise SystemExit(app.run([sys.argv[0]]))
