# Synthetic template only. Replace locally, never commit completed values.
# Helper's local ~/.ssh/config:
Host family-learner-a-view
    HostName <learner-a-address>
    User <learner-a-login>
    IdentityFile <absolute-learner-a-view-private-key-path>
    IdentitiesOnly yes
    ForwardAgent no
    ForwardX11 no
    ClearAllForwardings yes
    StrictHostKeyChecking yes

Host family-learner-b-view
    HostName <learner-b-address>
    User <learner-b-login>
    IdentityFile <absolute-learner-b-view-private-key-path>
    IdentitiesOnly yes
    ForwardAgent no
    ForwardX11 no
    ClearAllForwardings yes
    StrictHostKeyChecking yes

# Each learner's local ~/.ssh/config (its own independent key):
Host family-helper-notify
    HostName <helper-address>
    User <helper-desktop-login>
    IdentityFile <absolute-notification-private-key-path>
    IdentitiesOnly yes
    ForwardAgent no
    ForwardX11 no
    ClearAllForwardings yes
    StrictHostKeyChecking yes

# Optional helper-side control alias: enroll a NEW control key separately.
# See docs/CONTROL.md; no control is enabled by the base configuration.
Host family-learner-a-control
    HostName <learner-a-address>
    User <learner-a-login>
    IdentityFile <absolute-learner-a-control-private-key-path>
    IdentitiesOnly yes
    ForwardAgent no
    ForwardX11 no
    ClearAllForwardings yes
    StrictHostKeyChecking yes

# Learner-side direct routes, each with an independent notification key.
Host family-dad-notify
    HostName <dad-helper-address>
    User <dad-desktop-login>
    IdentityFile <absolute-learner-to-dad-notification-key-path>
    IdentitiesOnly yes
    ForwardAgent no
    ForwardX11 no
    ClearAllForwardings yes
    StrictHostKeyChecking yes

Host family-mom-notify
    HostName <mom-helper-address>
    User <mom-desktop-login>
    IdentityFile <absolute-learner-to-mom-notification-key-path>
    IdentitiesOnly yes
    ForwardAgent no
    ForwardX11 no
    ClearAllForwardings yes
    StrictHostKeyChecking yes

# Dad-side relay alias: NEW key scoped to receive-forward dad learner-a on Mom.
Host family-mom-learner-a-relay
    HostName <mom-helper-address>
    User <mom-desktop-login>
    IdentityFile <absolute-dad-to-mom-learner-a-relay-key-path>
    IdentitiesOnly yes
    ForwardAgent no
    ForwardX11 no
    ClearAllForwardings yes
    StrictHostKeyChecking yes
